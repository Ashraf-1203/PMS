REACT_APP_API_URL=http://localhost:5000/api

# For development, if your React app and Node backend are on different ports,
# you might not need this if CORS is correctly set up on the backend.
# However, for some proxying needs during development, you might use:
# PORT=3000 (if your React app runs on a different port than default 3000)
# HTTPS=true (if you need to run React app on https locally)
# HOST=localhost (explicitly set host)
